@model IEnumerable<EmprestimosModel>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1>Empréstimos</h1>
        <a class="btn btn-success mx-2" asp-controller="Emprestimo" asp-action="Cadastrar">Cadastrar novo empréstimo</a>
    </div>

<table class="table table-dark table-hover">
    <thead>
        <tr>
            <th scope="col">Recebedor</th>
            <th scope="col">Fornecedor</th>
            <th scope="col">Livro</th>
            <th scope="col">Ultima Atualização</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @if (Model != null)
        {
            @foreach (var emprestimo in Model) {
                <tr>
                    <th scope="row">@emprestimo.Recebedor</th>
                    <td>@emprestimo.Forcenedor</td>
                    <td>@emprestimo.LivroEmprestado</td>
                    <td>@emprestimo.dataUltimaAtualização</td>
                        <td>
                            <a class="btn btn-warning mx-2" asp-controller="Emprestimo" asp-route-id="@emprestimo.Id" asp-action="Editar">Editar</a>
                            <a class="btn btn-danger mx-2" asp-controller="Emprestimo" asp-route-id="@emprestimo.Id" asp-action="Excluir">Excluir</a>
                </tr>
            }
        }

    </tbody>
</table>
</div>